// Cloudflare Workers static assets: serves the Vite build. No Worker code; deep links like
// /clips/123 fall back to index.html so React Router handles them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp-clip",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
