# Copy to supabase/.env (gitignored). Used by scripts/ and tests/ only, never by the web app.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (Project Settings > API Keys > Secret keys). Bypasses RLS: keep it out of git and chat.
SUPABASE_SECRET_KEY=sb_secret_...
